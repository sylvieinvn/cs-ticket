# Supabase (Project Settings → API). Leave both empty to run in browser-only mode
# (no login, data saved in each browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: needed for Gmail sync. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail sync: Google Cloud OAuth client (Web application) with the Gmail API enabled.
# Authorized redirect URI: <your app URL>/api/gmail/callback. Then use Settings → "Kết nối Gmail".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI conversation summary.
ANTHROPIC_API_KEY=
